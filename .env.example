# Copy to .env and fill in. Never commit .env.

# Dashboard login password (required).
BOURSY_APP_PASSWORD=change-me

# Host port of the dashboard (http://<pi-address>:8090).
BOURSY_PORT=8090

# Cookie signing secret. Leave empty: a random one is generated and kept in the data volume.
BOURSY_SESSION_SECRET=

# Set to true only when the dashboard is served over HTTPS (reverse proxy).
BOURSY_COOKIE_SECURE=false

# Link used in notifications, e.g. https://boursy.example.org
BOURSY_PUBLIC_URL=

# --- Push notifications (ntfy). Use a long random topic and subscribe to it in the ntfy app.
BOURSY_NTFY_URL=https://ntfy.sh
BOURSY_NTFY_TOPIC=
BOURSY_NTFY_TOKEN=

# --- Email (SMTP). Port 587 = STARTTLS, 465 = SSL.
BOURSY_SMTP_HOST=
BOURSY_SMTP_PORT=587
BOURSY_SMTP_USER=
BOURSY_SMTP_PASSWORD=
BOURSY_SMTP_FROM=
BOURSY_MAIL_TO=

# --- Claude (AI analyst). Pick the backend in Settings; set the matching secret here.
# API backend: pay per token.
ANTHROPIC_API_KEY=
# Subscription backend: run `claude setup-token` on your PC (valid one year). Personal use only.
CLAUDE_CODE_OAUTH_TOKEN=
