# Copy to .env and fill in. Never commit .env.

# Dashboard login password (required).
BOURSY_APP_PASSWORD=change-me

# Host port of the dashboard (http://<pi-address>:8090).
BOURSY_PORT=8090

# Cookie signing secret. Leave empty: a random one is generated and kept in the data volume.
BOURSY_SESSION_SECRET=

# Set to true only when the dashboard is served over HTTPS (reverse proxy).
BOURSY_COOKIE_SECURE=false
